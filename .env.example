# =============================================================================
# KHAMADI ONLINE — environment template
# Copy to .env.local and fill values:
#   cp .env.example .env.local
#
# Supabase Dashboard → Project Settings → API
# There is no separate local DB in this repo — URL usually points at the
# shared cloud project (often production). Be careful with SERVICE_ROLE_KEY.
# =============================================================================

# --- Required: Supabase (auth + DB for /ent, /english, /english/zku) ---------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# --- Optional: AI (ҰБТ AI + English ai-proxy) --------------------------------
# Without this: AI tutor / review / analysis / writing coach proxy fail
ANTHROPIC_API_KEY=

# --- Optional: TTS (English /api/english/tts) --------------------------------
# Without this: text-to-speech fails
OPENAI_API_KEY=

# --- Optional: email (resend package is installed; wire when needed) ---------
# RESEND_API_KEY=
