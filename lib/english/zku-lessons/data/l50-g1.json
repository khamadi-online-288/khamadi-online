  "grammarTitle": "Gerunds — Verbs That Take -ing",
  "grammarNote": "Герундий (gerund) — это глагол с окончанием -ing, который используется как существительное. После определённых глаголов в английском языке ОБЯЗАТЕЛЬНО используется герундий. Нельзя использовать инфинитив. Это нужно запомнить как лексическую единицу: \"enjoy + V-ing\", \"avoid + V-ing\" и т.д.",
  "grammarTable": [
    {
      "subject": "enjoy",
      "verb": "+ V-ing",
      "short": "получать удовольствие",
      "example": "\"I enjoy reading before bed.\" / \"She enjoys cooking.\""
    },
    {
      "subject": "mind",
      "verb": "+ V-ing",
      "short": "возражать (обычно отриц.)",
      "example": "\"I don't mind waiting.\" / \"Do you mind helping?\""
    },
    {
      "subject": "avoid",
      "verb": "+ V-ing",
      "short": "избегать",
      "example": "\"She avoids eating late at night.\" / \"Avoid making noise.\""
    },
    {
      "subject": "keep",
      "verb": "+ V-ing",
      "short": "продолжать / не переставать",
      "example": "\"He keeps forgetting.\" / \"Stop keeping me waiting.\""
    },
    {
      "subject": "finish",
      "verb": "+ V-ing",
      "short": "заканчивать",
      "example": "\"Have you finished studying?\" / \"I finished writing.\""
    },
    {
      "subject": "consider",
      "verb": "+ V-ing",
      "short": "рассматривать возможность",
      "example": "\"She's considering leaving.\" / \"Consider applying.\""
    },
    {
      "subject": "suggest",
      "verb": "+ V-ing",
      "short": "предлагать",
      "example": "\"He suggested going for a walk.\" / \"She suggested stopping.\""
    },
    {
      "subject": "practise",
      "verb": "+ V-ing",
      "short": "практиковаться",
      "example": "\"Practise speaking every day.\" / \"She practises writing.\""
    }
  ],
  "grammarExtra": [
    {
      "title": "Full list: verbs always followed by gerund",
      "color": "#1D9E75",
      "bg": "#D1FAE5",
      "border": "#6EE7B7",
      "rows": [
        {
          "form": "enjoy / love / hate / like / prefer",
          "example": "\"She loves dancing.\" / \"He hates waiting.\" / \"They prefer staying in.\" ✅"
        },
        {
          "form": "avoid / mind / miss / risk",
          "example": "\"Avoid eating late.\" / \"I miss seeing you.\" / \"Risk losing everything.\""
        },
        {
          "form": "keep / carry on / give up / stop*",
          "example": "\"Keep trying!\" / \"Carry on working.\" / \"Give up smoking.\" / \"Stop complaining.\""
        },
        {
          "form": "finish / imagine / practise / suggest",
          "example": "\"Finish writing.\" / \"Imagine living there.\" / \"Suggest taking a break.\""
        },
        {
          "form": "consider / delay / deny / admit",
          "example": "\"Consider leaving.\" / \"Deny doing it.\" / \"Admit making a mistake.\""
        },
        {
          "form": "fancy / involve / recommend / regret*",
          "example": "\"Fancy trying?\" / \"Involves working hard.\" / \"Regret saying that.\""
        }
      ]
    },
    {
      "title": "Gerund as subject of the sentence",
      "color": "#003876",
      "bg": "#EEF2F7",
      "border": "rgba(0,56,118,0.2)",
      "rows": [
        {
          "form": "Running is good for you.",
          "example": "\"RUNNING is excellent cardio.\" — gerund as subject ✅"
        },
        {
          "form": "Studying takes time.",
          "example": "\"STUDYING for exams takes a lot of time and energy.\" ✅"
        },
        {
          "form": "Making mistakes is normal.",
          "example": "\"MAKING mistakes is how you learn.\" ✅"
        },
        {
          "form": "Waiting too long is a mistake.",
          "example": "\"WAITING too long is a common mistake.\" ✅"
        }
      ]
    },
    {
      "title": "Gerund after prepositions (ALWAYS)",
      "color": "#1B8FC4",
      "bg": "#DBEAFE",
      "border": "#93C5FD",
      "rows": [
        {
          "form": "After \"in\"",
          "example": "\"Interested IN learning.\" / \"Succeed IN passing.\" ✅"
        },
        {
          "form": "After \"at\"",
          "example": "\"Good AT speaking.\" / \"Bad AT writing.\" ✅"
        },
        {
          "form": "After \"to\" (not inf.)",
          "example": "\"Look forward TO seeing.\" / \"Used TO working.\" ✅ (NOT \"to see\" / \"to work\")"
        },
        {
          "form": "After \"about\"",
          "example": "\"Think ABOUT going.\" / \"Worry ABOUT failing.\" ✅"
        },
        {
          "form": "After \"of\"",
          "example": "\"Tired OF waiting.\" / \"Afraid OF making mistakes.\" ✅"
        },
        {
          "form": "After \"for\"",
          "example": "\"Thank you FOR coming.\" / \"Responsible FOR organising.\" ✅"
        }
      ]
    },
    {
      "title": "❌ Common gerund mistakes",
      "color": "#EF4444",
      "bg": "#FEF2F2",
      "border": "#FECACA",
      "rows": [
        {
          "form": "✗ \"I enjoy to read.\"",
          "example": "✅ \"I enjoy READING.\" — enjoy always + gerund."
        },
        {
          "form": "✗ \"She avoids to eat late.\"",
          "example": "✅ \"She avoids EATING late.\" — avoid always + gerund."
        },
        {
          "form": "✗ \"He keeps to forget.\"",
          "example": "✅ \"He keeps FORGETTING.\" — keep always + gerund."
        },
        {
          "form": "✗ \"I look forward to see you.\"",
          "example": "✅ \"I look forward to SEEING you.\" — \"to\" here = preposition, not infinitive marker!"
        }
      ]
    }
  ],
  "grammarTip": "Герундий (V-ing как существительное) — запомни глаголы:\n\nenjoy, mind, avoid, miss, keep, give up,\nfinish, consider, suggest, practise,\nimagine, deny, admit, delay, involve,\nrecommend, fancy, risk, regret\n\n→ Все они + V-ing (НИКОГДА + to-infinitive!)\n\n💡 После ПРЕДЛОГОВ всегда герундий:\n\"good AT speaking\" ✅\n\"look forward TO seeing\" ✅\n\"tired OF waiting\" ✅\n\"thank you FOR coming\" ✅\n\n⚠️ \"look forward to SEEING\" — здесь TO = предлог!\nНЕ инфинитив! Поэтому SEEING, а не SEE!",
